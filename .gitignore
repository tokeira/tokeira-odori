criterion/

# Archives
*.zip

# Proptest regressions (generated, not committed)
**/proptest-regressions/

# Scratch directory for commit messages, patch snapshots, and similar
# transient files. Nothing in this directory is ever committed.
/artifacts/

# Codex silently prefers this file over AGENTS.md — never commit one
AGENTS.override.md

# Machine-local Claude Code imports (the operator's private pointers); carried
# into worktrees by .worktreeinclude, never committed.
CLAUDE.local.md

# Claude Code session-local state
.claude/settings.local.json
.claude/worktrees/
.claude/launch.json
.claude/wf-*.js
